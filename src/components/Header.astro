---
import { site } from '../content/site';

const navigation = [
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Fechas', href: '#fechas' },
  { label: 'Escuchá', href: '#escucha' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="site-header">
  <a class="wordmark" href="#inicio" aria-label={`${site.artist.name}, inicio`}>
    <span class="wordmark__initials" aria-hidden="true">WZ</span>
    <span class="wordmark__name" aria-hidden="true">Walter<br /><i>Zelaya</i></span>
  </a>
  <nav class="site-nav" aria-label="Navegación principal">
    {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <details class="site-menu">
    <summary class="site-menu__toggle">
      <span>Menú</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </summary>
    <nav aria-label="Navegación móvil">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </details>
</header>
