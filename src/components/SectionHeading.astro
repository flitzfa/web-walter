---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  intro?: string;
}

const { number, eyebrow, title, intro } = Astro.props;
---

<header class="section-heading">
  <div class="section-heading__meta"><span>{number}</span><span>{eyebrow}</span></div>
  <h2>{title}</h2>
  {intro && <p>{intro}</p>}
</header>
