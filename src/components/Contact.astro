---
import { site } from '../content/site';
---

<footer class="contact" id="contacto">
  <div class="contact__light" aria-hidden="true"></div>
  <div class="shell contact__inner">
    <p class="eyebrow"><span></span>Contacto / contrataciones</p>
    <h2>Hablemos de<br /><em>música.</em></h2>
    <!-- TODO: Reemplazar el correo y las redes en src/content/site.ts. -->
    <a class="contact__mail" href={`mailto:${site.artist.email}`}>{site.artist.email} <span>↗</span></a>
    <div class="contact__bottom">
      <p>© {new Date().getFullYear()} {site.artist.name}</p>
      <nav aria-label="Redes sociales">
        {site.socials.map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.label}</a>)}
      </nav>
    </div>
  </div>
</footer>
