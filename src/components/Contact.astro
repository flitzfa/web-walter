---
import { isValidEmail, isValidExternalUrl, site } from '../content/site';
---

<footer class="contact" id="contacto">
  <div class="contact__light" aria-hidden="true"></div>
  <div class="shell contact__inner">
    <p class="eyebrow"><span></span>Contacto / contrataciones</p>
    <h2>Hablemos de<br /><em>música.</em></h2>
    <div class="contact__actions">
      {isValidEmail(site.artist.email) ? (
        <a class="contact__mail" href={`mailto:${site.artist.email}`}>{site.artist.email} <span>↗</span></a>
      ) : (
        <p class="contact__pending">Correo de contacto pendiente de confirmar</p>
      )}
      {isValidExternalUrl(site.artist.whatsappUrl) && (
        <a class="contact__whatsapp" href={site.artist.whatsappUrl} target="_blank" rel="noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.84 11.84 0 0 0 12.08 0C5.5 0 .15 5.35.15 11.93c0 2.1.55 4.15 1.6 5.96L.05 24l6.27-1.64a11.9 11.9 0 0 0 5.75 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.19-3.49-8.42ZM12.08 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.72.98.99-3.63-.24-.37a9.88 9.88 0 0 1-1.52-5.26c0-5.46 4.44-9.9 9.9-9.9 2.65 0 5.14 1.03 7.01 2.9a9.84 9.84 0 0 1 2.9 7c0 5.46-4.44 9.9-9.9 9.9Zm5.43-7.41c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.5 1.69.64.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"/></svg>
          Escribir por WhatsApp <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
    <div class="contact__bottom">
      <p>© {new Date().getFullYear()} {site.artist.name}</p>
      {site.socials.some((social) => isValidExternalUrl(social.href)) ? (
        <nav aria-label="Redes sociales">
          {site.socials.filter((social) => isValidExternalUrl(social.href)).map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.label}</a>)}
        </nav>
      ) : (
        <p class="contact__pending">Redes oficiales pendientes de confirmar</p>
      )}
    </div>
  </div>
</footer>
